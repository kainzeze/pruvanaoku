DirectoryIndex index.php

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On
RewriteRule ^_kaynak(/|$) - [F]
RewriteRule ^partials(/|$) - [F]
RewriteRule ^(index|hakkimizda|siniflarimiz|gorsel-galeri|okul-gorselleri|brans-dersleri|kayitlar|iletisim)\.html$ $1.php [R=301,L,QSA]

<FilesMatch "\.(py|json)$">
  Require all denied
</FilesMatch>
